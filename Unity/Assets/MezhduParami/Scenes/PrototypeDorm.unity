MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1548145412}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: acbbd8f77d8121b479b86555bb587f4b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: MezhduParami.Runtime::MezhduParami.WorldInteraction
  Id: npc.sasha
  DisplayName: "\u0421\u0430\u0448\u0430 \u2014 \u0441\u043E\u0441\u0435\u0434 \u043F\u043E
    \u043E\u0431\u0449\u0430\u0433\u0435"
  Activity: {fileID: 0}
  Conversation: "\u041F\u0440\u0438\u0432\u0435\u0442! \u0420\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u0439\u0441\u044F.
    \u0417\u0430 \u0441\u0442\u043E\u043B\u043E\u043C \u043C\u043E\u0436\u043D\u043E
    \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C\u0441\u044F
    \u043A \u0437\u0430\u043D\u044F\u0442\u0438\u044F\u043C, \u043D\u0430 \u0434\u043E\u0441\u043A\u0435
    \u0435\u0441\u0442\u044C \u043F\u0440\u043E\u0441\u0442\u0430\u044F \u043F\u043E\u0434\u0440\u0430\u0431\u043E\u0442\u043A\u0430.
    \u0423\u0441\u0442\u0430\u043D\u0435\u0448\u044C \u2014 \u043E\u0442\u0434\u043E\u0445\u043D\u0438.\n\n\u041D\u0430
    \u0443\u0442\u0440\u043E, \u0434\u0435\u043D\u044C \u0438 \u0432\u0435\u0447\u0435\u0440
    \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443
    \u0431\u043E\u043B\u044C\u0448\u043E\u043C\u0443 \u0434\u0435\u043B\u0443. \u0410
    \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0438 \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C\u0441\u044F
    \u043C\u043E\u0436\u043D\u043E \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E."
