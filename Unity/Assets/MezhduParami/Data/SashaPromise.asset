  m_Script: {fileID: 11500000, guid: f42a5d37cc4b950428b5fd66425f164e, type: 3}
  m_Name: SashaPromise
  m_EditorClassIdentifier: MezhduParami.Runtime::MezhduParami.SashaQuestDefinition
  Id: sasha.prototype.promise
  OfferDay: 1
  DueDay: 3
  DuePeriod: 2
  Consultation: {fileID: 11400000, guid: 405b5aa6a32cc1040ace018880a9dee2, type: 2}
  Help: {fileID: 11400000, guid: cabfcb3a4bf52484282959ad8ff3779d, type: 2}
  SpecialShift: {fileID: 11400000, guid: d4bf040a9f965b44eb1c5d74d0fd3998, type: 2}
  OfferText: "\u041F\u043E\u043C\u043E\u0433\u0443 \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
    \u0441 \u0443\u0447\u0451\u0431\u043E\u0439 \u0441\u0435\u0439\u0447\u0430\u0441.
    \u0412\u0437\u0430\u043C\u0435\u043D \u043F\u043E\u043C\u043E\u0433\u0438 \u043C\u043D\u0435
    \u0441 \u043F\u0440\u043E\u0435\u043A\u0442\u043E\u043C \u0432\u0435\u0447\u0435\u0440\u043E\u043C
    \u0434\u043D\u044F 3. \u0421\u043E\u0433\u043B\u0430\u0441\u0438\u0448\u044C\u0441\u044F?
    \u041E\u0442\u043A\u0430\u0437 \u043D\u0435 \u043C\u0435\u0448\u0430\u0435\u0442
    \u0437\u0430\u043D\u0438\u043C\u0430\u0442\u044C\u0441\u044F \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E."
  FulfilledText: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0437\u0430 \u043F\u043E\u043C\u043E\u0449\u044C!
    \u041F\u0440\u043E\u0435\u043A\u0442 \u0433\u043E\u0442\u043E\u0432. \u0422\u0435\u043F\u0435\u0440\u044C
    \u044F \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u043D\u0430 \u0442\u0435\u0431\u044F
    \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C\u0441\u044F."
  BrokenText: "\u042F \u0436\u0434\u0430\u043B \u0442\u0435\u0431\u044F \u0441 \u043F\u0440\u043E\u0435\u043A\u0442\u043E\u043C.
    \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0442\u044C
    \u043E\u0434\u043D\u043E\u043C\u0443. \u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
    \u0440\u0430\u0437 \u0437\u0430\u0440\u0430\u043D\u0435\u0435 \u0441\u043A\u0430\u0436\u0438,
    \u0435\u0441\u043B\u0438 \u043D\u0435 \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u0448\u044C."
  DeclinedText: "\u0425\u043E\u0440\u043E\u0448\u043E, \u0431\u0435\u0437 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432.
    \u0415\u0441\u043B\u0438 \u043F\u0435\u0440\u0435\u0434\u0443\u043C\u0430\u0435\u0448\u044C
    \u043D\u0430\u0441\u0447\u0451\u0442 \u0443\u0447\u0451\u0431\u044B, \u0437\u0430
    \u0441\u0442\u043E\u043B\u043E\u043C \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C\u0441\u044F
    \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E."
