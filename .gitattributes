* text=auto eol=lf
*.md text eol=lf
*.cs text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.uxml text eol=lf
*.uss text eol=lf
*.docx binary
*.png binary
*.jpg binary
*.jpeg binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary

# Unity's serializer writes empty YAML fields with a trailing space.
*.meta whitespace=-blank-at-eol
*.asset whitespace=-blank-at-eol
*.unity whitespace=-blank-at-eol
*.prefab whitespace=-blank-at-eol
*.anim text eol=lf whitespace=-blank-at-eol
*.controller text eol=lf whitespace=-blank-at-eol
*.scenetemplate whitespace=-blank-at-eol
*.mat whitespace=-blank-at-eol
"Unity/Assets/TextMesh Pro/**" whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
# Preserve the upstream font license verbatim.
Unity/Assets/MezhduParami/Fonts/Interface/*-OFL.txt whitespace=-blank-at-eol

# Preserve the designer's original project byte-for-byte, including CRLF.
/Assets/** -text
/Packages/** -text
/ProjectSettings/** -text
/UserSettings/** -text
